<?xml version="1.0" encoding="UTF-8"?>
<component>

    <api>
        <prop name="title"     type="string" default="TITLE"/>
        <prop name="icon_text" type="string" default="?"/>
    </api>

    <view extends="lv_obj" width="96" height="42">
        <style name="card"/>

        <lv_obj name="reflection" width="100%" height="2" align="top_mid"
                style_bg_color="#white" style_bg_opa="25" style_radius="10"/>

        <lv_label name="title" text="$title" align="top_mid" x="10" y="2"
                  style_text_color="#white" style_text_font="montserrat_14"/>

        <lv_label name="icon" text="$icon_text" align="left_mid" x="6" y="4"
                  style_text_color="#accent" style_text_font="montserrat_14"/>

        <lv_switch name="sw" width="32" height="16" align="bottom_right" x="-4" y="-4"
                   style_bg_color="#accent" style_selector="indicator|checked"
                   style_bg_color2="0x3A444E" style_selector2="main"/>
    </view>

</component>
