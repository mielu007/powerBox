<?xml version="1.0" encoding="UTF-8"?>
<screen>
    <view style_bg_color="#bg">

        <lv_label text="AUTO START" align="top_mid" y="18"
                  style_text_color="#accent" style_text_font="montserrat_14"/>

        <switch_card title="LODOWKA"  icon_text="PWR" x="20"  y="38"/>
        <switch_card title="USB-C"    icon_text="USB" x="124" y="38"/>
        <switch_card title="USB-A"    icon_text="CHG" x="20"  y="84"/>
        <switch_card title="INWERTER" icon_text="CFG" x="124" y="84"/>

        <lv_label name="lbl_delay" text="ZWLOKA: 5 s" align="top_mid" y="120"
                  style_text_color="#accent" style_text_font="montserrat_14"/>

        <lv_slider name="slider_delay" width="150" height="10" align="top_mid" y="144"
                   min_value="1" max_value="30" value="5"
                   style_bg_color="#accent" style_selector="indicator"
                   style_bg_color2="#accent" style_selector2="knob"/>

        <lv_button name="btn_back" width="100" height="28" align="bottom_mid" y="-18"
                   style_radius="14" style_border_color="#accent" style_border_width="1"
                   style_bg_color="#card_bg">
            <lv_label text="&lt; WRT" align="center" style_text_color="#white"/>
            <screen_load_event screen="tile_main" trigger="clicked" anim_type="move_right"/>
        </lv_button>

    </view>
</screen>
